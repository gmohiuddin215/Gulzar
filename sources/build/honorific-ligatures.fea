  sub AINu1' lookup HonorificLigatures zain-ar' VAOu1' space' jim-ar' LAMu1';
  ignore sub @HonorificLetters AINu1' zain-ar' space' VAOu1' jim-ar' LAMu1';
  ignore sub AINu1' zain-ar' space' VAOu1' jim-ar' LAMu1' @HonorificLetters;
  sub AINu1' lookup HonorificLigatures zain-ar' space' VAOu1' jim-ar' LAMu1';
  ignore sub @HonorificLetters qaf-ar' DALu1' SINu1' SINu1' REu1' HAYCu1';
  ignore sub qaf-ar' DALu1' SINu1' SINu1' REu1' HAYCu1' @HonorificLetters;
  sub qaf-ar' lookup HonorificLigatures DALu1' SINu1' SINu1' REu1' HAYCu1';
  ignore sub @HonorificLetters AINu1' zain-ar' VAOu1' jim-ar' LAMu1';
  ignore sub AINu1' zain-ar' VAOu1' jim-ar' LAMu1' @HonorificLetters;
  sub AINu1' lookup HonorificLigatures zain-ar' VAOu1' jim-ar' LAMu1';
} HonorificPhrases;

# harakat typed inside a phrase are left after its glyph: empty them
lookup HonorificHarakat {
  sub [@Honorifics honorificMark] @HonorificHarakat' by honorificMark;
} HonorificHarakat;

feature ccmp {
  lookup HonorificNormalize;
  lookup HonorificPhrases;
  lookup HonorificHarakat;
} ccmp;
