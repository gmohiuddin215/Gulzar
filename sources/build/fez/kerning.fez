LoadPlugin karakul.NastaliqKerning;
Include "shared.fez";

# We change the space.urdu category to "ligature", so that we can
# kern across spaces by using the IgnoreLigatures flag.
LoadPlugin FontEngineering;
SetCategory space.urdu ligature;
SetCategory comma.urdu ligature;

DefineClass @narrowmedi = /.*m\d+$/  & (run < 350);

Routine NastaliqKerning {
    NastaliqKerning 120 65%;
} IgnoreMarks IgnoreLigatures;

Feature kern {
	# This runs the autokerner, and brings together initial glyphs
	# and final glyphs to within either 90 units of one another or
	# to a maximum of 75% of the final glyph's width "under" the
	# final glyph, whichever is the smallest.
	# We don't kern bari-yes, and we have to include BARI_YEu1 in that.
	DefineClass @bariye = /BARI_YE/;
    Routine RunKerner {
    		# We should be able to contextualise this more, but it's not
    		# working and I don't understand why not.
        Chain ([@isols @finas] ^NastaliqKerning);
    } IgnoreMarks IgnoreLigatures;

	# The autokerner only considers the space underneath two glyphs:
	# the final/isolate of one "word" and the initial of the next. But
	# if the initial is followed by another letter which "curls back"
	# into the space beneath the initial (for example, a JIM), then
	# the final can actually collide with the medial. We don't expect
	# the autokerner to detect this, and deal with it manually.
	Routine FixShortKern {
		Position [@isols @finas] (/([KG]AF|LAM)i/ <xAdvance=+100>) /JIMm|BEm14/;
		Position [@isols @finas] (/([KG]AF|LAM)i/ <xAdvance=+100>) /BEm9/;
		Position [REf2 REf3] ([FEi13 GAFi13 KAFi13 BEi13 TEi13 AINi13  LAMi13 LAMi2 LAMi9] <xAdvance=+270>) @finas; # دبی
		Position REu1 ([FEi13 GAFi13 KAFi13 BEi13 TEi13 AINi13  LAMi13 LAMi2 LAMi9] <xAdvance=+250>) @finas; # دبی
		Position REf1 ([FEi13 GAFi13 KAFi13 BEi13 TEi13 AINi13  LAMi13 LAMi2 LAMi9] <xAdvance=+200>) @finas; # دبی
		Position @dal_like ([AINi13] <xAdvance=+100>) @finas; # دبی
		Position @vao_like ([AINi13] <xAdvance=+100>) @finas; # عمومی
		Position [@vao_like @dal_like] ([JIMi13] <xAdvance=+50>) @finas; # فوجی
		Position [@vao_like @dal_like] ([MIMi13] <xAdvance=+150>) @finas; # گرمی
		Position @dal_like ([FEi13 GAFi13 KAFi13 BEi13 TEi13 LAMi13 LAMi2 LAMi9] <xAdvance=+220>) @finas; # دبی
		Position @vao_like ([FEi13 GAFi13 KAFi13 BEi13 TEi13 LAMi13 LAMi2 LAMi9] <xAdvance=+220>) @finas; # وبی
		Position @mim_like ([FEi13 GAFi13 KAFi13 BEi13 TEi13 LAMi13 LAMi2 LAMi9] <xAdvance=+160>) @finas; # م بی
		Position @alif_like ([BEi13 TEi13 AINi13  LAMi13] <xAdvance=+150>) @finas;
		Position @alif_like ([FEi13 GAFi13 KAFi13 LAMi2 LAMi9] <xAdvance=+120>) @finas; #  
		Position @alif_like ([GAFi17 KAFi17] <xAdvance=+150>) @finas; # کجاکخ
		Position @alif_like ([LAMi9] <xAdvance=+100>) /MIMm/; # المللی
		Position [@isols @finas] ([FEi13 GAFi13 KAFi13 BEi13 TEi13 AINi13  LAMi13 LAMi2 LAMi9] <xAdvance=+200>) @finas; # الی

		Position [@isols @finas] ([BEi1 TEi1 FEi1 FEi7] <xAdvance=+170>) @finas; # سابع
		Position [@isols @finas] ([JIMi7] <xAdvance=+100>) @finas; # أحج
		Position [@isols @finas] ([LAMi7] <xAdvance=+250>) JIMf1; # صالح
		Position [@isols @finas] (@inits <xAdvance=+100>) @narrowmedi AINf1; # صالح
		Position [@isols @finas] ([GAFi5 KAFi5] <xAdvance=+100>) HAYAf1; # رکھ
		Position @alif_like ([GAFi5 KAFi5] <xAdvance=+100>); # لاکھوں

		Position ([BEisd1 TEisd1]  <xAdvance=+100>) TEm7 JIMf1;
		Position /(CH_YE)[uf]/ ([BEi13 TEi13 LAMi11 LAMi2 LAMi9] <xAdvance=+300>); # یی پی

		Position ([BEi7 TEi7] <xAdvance=+100>) JIMf1;
	} IgnoreMarks;

	# And finally some ad-hoc fixes...

	Routine OtherKerningFixes {
		# The Urdu space is narrow, so that words sit close together as in
		# traditional Nastaliq setting. Dots after a space are never dropped
		# (they help mark the start of the word), so when the next word starts
		# with dots below, give them back room to clear the previous word.
		# ...except after a re, whose tail leaves room under it (منبر پر).
		Position [REf1 REu1] (space.urdu <xAdvance=+20>) @inits [sdb ddb tdb];
		Position REf2 (space.urdu <xAdvance=+130>) @inits [sdb ddb tdb]; # the longer tail of مر، پھر
		Position REf3 (space.urdu <xAdvance=+50>) @inits [sdb ddb tdb];
		Position REf1 (@inits <xAdvance=+70>) [tdb tdb.one tdb.two]; # پرچھا
		Position (space.urdu <xAdvance=+100>) @inits [sdb ddb tdb];
		Position @bigbowlfina space.urdu (/([KG]AF|LAM)i/ <xAdvance=+50>) /JIMm|BEm/ [ddb tdb];
		Position REf3 (/[KG]AFi/ <xAdvance=-120>);
		Position @vao_like (space.urdu <xAdvance=50>) /AINi/;
		Position /NUN[uf]/ (space.urdu <xAdvance=100>) /HAYCi/;
		Position [REf2 REf3] (ALIFu1 <xAdvance=200>) [BEi11 TEi11];
		Position [REf2 REf3] (SADu1 <xAdvance=200>); # عرض
		Position @dal_like (ALIFu1 <xAdvance=-50>); # جدا
		Position AINi17 [REf2 REf3] (/SAD/ <xAdvance=+150>); # عرصئہِ
	} UseMarkFilteringSet /[sdt]db/;

	# The long re of پیرو, خبریں is raised a little, so its tail now reaches
	# into the dots below the letter after it, and the dot of its zain comes
	# close to the next word's kaf or dots: give them a little more room.
	Routine RaisedLongRe {
		Position REf3 (@inits <xAdvance=+60>) [sdb ddb tdb ddb.one tdb.one sdb.one]; # خبریں
		Position REf3 (space.urdu <xAdvance=+60>) @inits KASRA; # باہر نِکال
	} UseMarkFilteringSet [sdb ddb tdb ddb.one tdb.one sdb.one KASRA];
	Routine ZainDotBeforeWord {
		Position REf3 sda (space.urdu <xAdvance=+60>) /^[KG]AFi/; # کنکشنز کا
		Position REf3 sda (space.urdu <xAdvance=+60>) @inits [sda dda tda]; # آئیکنز شامل
	} UseMarkFilteringSet [sda dda tda];

	# The longer foot of dal lets the next word part tuck in over it, but
	# the autokerner does not see the dot of zal above: give it room back.
	Routine ZalDotBeforeWord {
		Position [DALu1 DALf1] sda (@JIMi <xAdvance=+250>); # ذخیرہ
		Position [DALu1 DALf1] sda (@inits <xAdvance=+100>);
	} UseMarkFilteringSet [sda];

	# Kaf and gaf before re (کر، گر) lean their long top stroke over the
	# word before, which keeps the autokerner far from it: draw the word in.
	Routine KarCloser {
		Position [@isols @finas] (space.urdu <xAdvance=-120>) [KAFi17 GAFi17] REf1;
	} UseMarkFilteringSet [sda sdb dda ddb tda tdb];
	# ...except after bari ye, whose tail already runs in under the kaf.
	Routine KarAfterBariYe {
		Position @bariye (space.urdu <xAdvance=+120>) [KAFi17 GAFi17] REf1;
	} UseMarkFilteringSet [sda sdb dda ddb tda tdb];

	# The foot of re leaves open room after it that the autokerner does not
	# take up when the next word starts low on its right (س، ص، ع، ط، ج،
	# م ...): draw the next word in, by four fifths of the gap measured after
	# re over the usual one, for each opening form, never closer than 140
	# at the nearest point.
	Routine AfterReCloser {
		Position [REu1 REf1] (space.urdu <xAdvance=-320>) [AINi24 AINi9 FEi10 FEi24 GAFi4 JIMi10 JIMi24 KAFi24 MIMi24 SADi4 SADi7 SINi10 SINi14 SINi8 TEi10];
		Position [REu1 REf1] (space.urdu <xAdvance=-300>) [SINi4 SINi6 SINi7];
		Position [REu1 REf1] (space.urdu <xAdvance=-280>) [BEi24 BEi4 SINi9];
		Position [REu1 REf1] (space.urdu <xAdvance=-260>) [BEi10 GAFi5 KAFi5 SADi16 TOEi16];
		Position [REu1 REf1] (space.urdu <xAdvance=-240>) [AINi10 AINi17 JIMi1 JIMi14 MIMi10 MIMi14 SINi18 TEi1];
		Position [REu1 REf1] (space.urdu <xAdvance=-220>) [AINi2 AINi4 FEi7 SINi12 SINi15 TOEi15];
		Position [REu1 REf1] (space.urdu <xAdvance=-200>) [BEi5 FEi17 JIMi18 KAFi9 LAMi16 MIMi18 SADi15 SADi2 TOEi18];
		Position [REu1 REf1] (space.urdu <xAdvance=-180>) [AINi18 LAMi12 MIMi1 MIMi16 TEi4 TEi5];
		Position [REu1 REf1] (space.urdu <xAdvance=-160>) [BEi1 FEi4 JIMi2 MIMi7 SINi13 SINi2];
		Position [REu1 REf1] (space.urdu <xAdvance=-140>) [BEi9 FEi14 GAFi16 GAFi17 GAFi6 KAFi16 KAFi17 KAFi6 MIMi4 MIMi6 TOEi2];
		Position [REu1 REf1] (space.urdu <xAdvance=-120>) [BEi6 HAYCi4 JIMi16 KAFi2 SINi3 TEi9];
		Position [REu1 REf1] (space.urdu <xAdvance=-100>) [AINi3 BEi7 HAYCi3 JIMi5 KAFisd15 SADi3];
		Position [REu1 REf1] (space.urdu <xAdvance=-80>) [LAMi1 LAMi15 TEi16 TEi7];
		Position [REu1 REf1] (space.urdu <xAdvance=-60>) [FEi15 GAFi92 HAYCi9 JIMi15 KAFi92 LAMi2 MIMi15 MIMi2];
		Position [REu1 REf1] (space.urdu <xAdvance=-40>) [BEi8 HAYCi13 LAMi3 LAMi93];
		Position [REu1 REf1] (space.urdu <xAdvance=-20>) [BEi14 BEi16 FEi3 GAFi11 GAFi2 GAFi3 JIMi12 JIMi3 KAFi11 KAFi3 LAMi11 LAMi9];
	} IgnoreMarks;

	# The joined re hangs low, taking the be/pe joined to it down with it: the
	# dots below them need more room from the word before (جس پر، طور پر).
	Routine DotsBeforeLowRe {
		Position (space.urdu <xAdvance=+140>) [BEi16 TEi16] [sdb ddb tdb] REf1;
	} UseMarkFilteringSet [sdb ddb tdb];

	# The rounded tail of re/zain lets the next letter come in closer; a
	# kasra under the re then meets the dots below that letter (زِیادہ).
	Routine KasraUnderRe {
		Position [REu1 REf1 REf2 REf3] KASRA (@inits <xAdvance=+40>) [sdb ddb tdb];
	} UseMarkFilteringSet [KASRA sdb ddb tdb];

	# A madda overhangs to the left, into the (narrow) space.
	Routine MaddaBeforeSpace {
		Position MADDA (space.urdu <xAdvance=+100>);
	};
};
