    Position /^VAO[uf]\d+$/ ([BEi3] <xAdvance=-40>) [LAMm6];
    Position /^VAO[uf]\d+$/ ([BEi3 HAYCi3] <xAdvance=-40>) [LAMm93];
    Position /^VAO[uf]\d+$/ ([BEi6] <xAdvance=-40>) [HAYCm13];
    Position /^VAO[uf]\d+$/ ([BEi7] <xAdvance=-40>) [JIMm2];
    Position /^VAO[uf]\d+$/ ([BEisd1] <xAdvance=-40>) [BEm5 TEm10 TEm13 TEm4];
    Position /^VAO[uf]\d+$/ ([FEi10 LAMi10] <xAdvance=-40>) [TOEm11];
    Position /^VAO[uf]\d+$/ ([FEi2 JIMi2] <xAdvance=-40>) [BEm11 TEm11];
    Position /^VAO[uf]\d+$/ ([FEi3] <xAdvance=-40>) [LAMm3];
    Position /^VAO[uf]\d+$/ ([GAFi5 KAFi5] <xAdvance=-40>) [HAYAm11];
    Position /^VAO[uf]\d+$/ ([HAYCi11] <xAdvance=-40>) [BARI_YEf1];
    Position /^VAO[uf]\d+$/ ([HAYCi3] <xAdvance=-40>) [DALf1];
    Position /^VAO[uf]\d+$/ ([HAYCi3 TEi3] <xAdvance=-40>) [LAMm2];
    Position /^VAO[uf]\d+$/ ([JIMi24] <xAdvance=-40>) [SINm11];
    Position /^VAO[uf]\d+$/ ([JIMi24 MIMi24 TEi24] <xAdvance=-40>) [SINm3];
    Position /^VAO[uf]\d+$/ ([JIMi2] <xAdvance=-40>) [TEm9];
    Position /^VAO[uf]\d+$/ ([JIMi5] <xAdvance=-40>) [HAYAm15];
    Position /^VAO[uf]\d+$/ ([JIMi9] <xAdvance=-40>) [MIMm2];
    Position /^VAO[uf]\d+$/ ([KAFisd15] <xAdvance=-40>) [TEm14];
    Position /^VAO[uf]\d+$/ ([LAMi9] <xAdvance=-40>) [MIMm7];
    Position /^VAO[uf]\d+$/ ([MIMi14] <xAdvance=-40>) [NUNf1];
    Position /^VAO[uf]\d+$/ ([MIMi15] <xAdvance=-40>) [BEm16 TEm16];
    Position /^VAO[uf]\d+$/ ([MIMi24] <xAdvance=-40>) [SINm2];
    Position /^VAO[uf]\d+$/ ([MIMi2] <xAdvance=-40>) [TEmsd16];
    Position /^VAO[uf]\d+$/ ([MIMi3] <xAdvance=-40>) [LAMm11];
    Position /^VAO[uf]\d+$/ ([MIMi7] <xAdvance=-40>) [JIMm11];
    Position /^VAO[uf]\d+$/ ([SINi10 TEi10] <xAdvance=-40>) [TOEf1];
    Position /^VAO[uf]\d+$/ ([SINi3] <xAdvance=-40>) [KAFm13];
    Position /^VAO[uf]\d+$/ ([SINi9] <xAdvance=-40>) [MIMf1];
    Position /^VAO[uf]\d+$/ ([TEi1] <xAdvance=-40>) [AINm7];
    Position /^VAO[uf]\d+$/ ([TEi5] <xAdvance=-40>) [HAYAm24 HAYAm7];
    Position /^VAO[uf]\d+$/ ([TEi7] <xAdvance=-40>) [JIMm9];
    Position /^VAO[uf]\d+$/ ([TEi9] <xAdvance=-40>) [MIMm1];
    Position /^VAO[uf]\d+$/ ([tcheh-ar] <xAdvance=-40>);
  } IgnoreMarks;

  # The dots of te/the just after alif reach back to the alif's stem (داتا).
  Routine TehDotsAfterAlif {
    Position /^ALIF[uf]\d+$/ (TEi3 <xAdvance=+50>) [dda tda];
  } UseMarkFilteringSet [dda tda];

  # The dot of ghain sits higher over the ain's head. (Moved left as well,
  # it runs into the letter after: پیغام، غلط، آغاز.)
  Routine GhainDot {
    Position /^AIN[im]\d+$/ (sda <yPlacement=+70>);
  } UseMarkFilteringSet [sda];

  # With the narrower word space, the tail of a final re reached the dots
  # under the first letter of the next word (بہتر بنانے، ر پب); give these
  # the old spacing back.
  Routine ReTailBeforeLowDots {
    Position /^RE[uf]\d+$/ (space.urdu <xAdvance=+30>) /^([BT]E|JIM)[iu]\d+$/ [sdb ddb tdb sdb.one ddb.one tdb.one];
  } UseMarkFilteringSet [sdb ddb tdb sdb.one ddb.one tdb.one];

  # The shortened initial kaf and gaf of اگر، کیا (see step_kaf_before_ye in
  # scripts/nastaliq-reshape.py) bring the sarkash down onto the dots of the
  # letter before (نوکر، توکیا): they move right and down, out from under it.
  Routine DotsUnderLowKaf {
    Position ([sda dda tda toeda] <xPlacement=+60 yPlacement=-40>) /^[KG]AFi(2|17)$/;
    Position ([sda dda tda toeda] <xPlacement=+60 yPlacement=-40>) [@vao_like @dal_like @alif_like] /^[KG]AFi(2|17)$/;
  } UseMarkFilteringSet [sda dda tda toeda];

  # Dots placed by hand where the general rules leave them too far from
  # their letter or against another dot (the word each rule is for is noted).
  Routine DotFinesse {
    # دیہی: the ye's dots below the line, the he's hook left of them
    Position /^(DAL|RE|VAO)[uf]\d+$/ /^[BT]Ei6$/ ([ddb ddb.two] <yPlacement=-210> /^HAYCm/ <xAdvance=0> haydb <xPlacement=-110 yPlacement=-10>);
    # دِیہات: the same with a zer under the dal, the dots less far down
    Position /^(DAL|RE|VAO)[uf]\d+$/ KASRA /^[BT]Ei6$/ ([ddb ddb.two] <xPlacement=-50 yPlacement=-110> /^HAYCm/ <xAdvance=0> haydb <xPlacement=-80 yPlacement=-10>);
    # دیتی: the ye's dots down and in, under the ye (the dal moves away)
    Position /^DAL[uf]\d+$/ /^[BT]Eisd1$/ (ddb <xPlacement=-30 yPlacement=-60>) /^[BT]Em13$/;
    # توفیق: the ye's dots a little left, clear of the vao (which moves away)
    Position /^VAO[uf]\d+$/ FEi2 sda /^[BT]Em15$/ (ddb <xPlacement=-30>);
    # وہی: the he's hook a little left of the vao
    Position /^VAO[uf]\d+$/ /^HAYCi13$/ (haydb <xPlacement=-40>) /^CH_YEf/;
    # پوچھا: the che's dots left and the pe's right, either side of the vao
    Position /^[BT]Ei\d+$/ (tdb <xPlacement=+40>) /^VAO[uf]\d+$/ /^JIMi5$/;
    Position /^VAO[uf]\d+$/ /^JIMi5$/ (tdb.one <xPlacement=-50 yPlacement=-30>) /^HAYA/;
    # سائنس: the noon's dot left and down, clear of the hamza
    Position /^[BT]Ei\d+$/ HAMZA_ABOVE.one /^[BT]Emsd\d+$/ (sda <xPlacement=-100 yPlacement=-60>);
    # قرآن: the qaf's dots right of the madda, the madda a little left
    Position /^FEi\d+$/ (dda <xPlacement=+90>) /^RE[uf]\d+$/ ALIFu1 MADDA;
    Position /^FEi\d+$/ dda /^RE[uf]\d+$/ ALIFu1 (MADDA <xPlacement=-40>);
    # سیکھ، سیکھنا: the ye's dots right and down, clear of the do-chashmi he
    Position /^SINi\d+$/ /^[BT]Em3$/ (ddb <xPlacement=+80 yPlacement=-60>) /^KAFm/;
    # ادیبوں: the ye's dots a little right, the be's dot up beside them
    Position /^[BT]Eisd\d+$/ (ddb <xPlacement=+50> /^[BT]Em15$/ <xAdvance=0> sdb.one <xPlacement=-135 yPlacement=+340>);
    # نشیبی: the ye's dots right, clear of the bowl; the be's dot up
    Position /^[BT]Emsd\d+$/ (ddb <xPlacement=+90> /^[BT]Em13$/ <xAdvance=0> sdb.yb <xPlacement=+20 yPlacement=+240>) /^CH_YEf/;
    # مستقبل: the te's dots lower, down towards the qaf's
    Position /^SIN[im]\d+$/ /^[BT]Em\d+$/ (dda.two <xPlacement=+80 yPlacement=-150>) /^FEm\d+$/ dda;
    # کابینہ: the ye's dots up beside the be's dot
    Position /^[BT]Ei\d+$/ (sdb <xPlacement=+30> /^[BT]Emsd1$/ <xAdvance=0> ddb.two <xPlacement=-140 yPlacement=+280>) /^[BT]Em3$/;
    # بست: the be's dot up under its letter
    Position /^[BT]Ei24$/ (sdb <xPlacement=-20 yPlacement=+110>) /^SINm/;
    # تربیت: the be's and ye's dots up and apart
    Position /^RE[uf]\d+$/ /^[BT]Eisd1$/ (sdb <xPlacement=+40 yPlacement=+115> /^[BT]Em12$/ <xAdvance=0> ddb.two <xPlacement=-90 yPlacement=+170>);
    # نئی: the noon's dot down beside the hamza
    Position /^[BT]Eisd\d+$/ (sda.two <xPlacement=+140 yPlacement=-440>) /^[BT]Em13$/ HAMZA_ABOVE;
    # تقریباً: the ye's and be's dots up and apart, either side of the re's tail
    Position /^RE[uf]\d+$/ /^[BT]Eisd1$/ (ddb.one <xPlacement=+120 yPlacement=+220> /^[BT]Em3$/ <xAdvance=0> sdb.two <xPlacement=-190 yPlacement=+320>) /^ALIFf/;
  } UseMarkFilteringSet [ddb ddb.two ddb.one haydb sdb sdb.one sdb.two sdb.yb dda dda.two sda sda.two tdb tdb.one HAMZA_ABOVE HAMZA_ABOVE.one MADDA KASRA];
  # (KASRA is in the set so that none of these fire where a zer stands
  # between the letters, as in دِیہات، قرِیباً: there the dots stay put.)



  # With the bowls on their own line, a word part that ends in a bowl sits
  # lower, and dal and re hang lower: the part after them then comes close
  # to their foot or to their dots and vowels, or brings its own dots up to
  # them. Each pair below was measured in the test texts (ink of the letters
  # and their marks) and is given back the room it had before.
  Routine RoomAfterLowerParts {
    Position ALIFf1 (space.urdu <xAdvance=+30>) REu1 FATHA;
    Position ALIFf1 (space.urdu <xAdvance=+10>) SINi3 tda;
    Position ALIFf1 (KAFi3 <xAdvance=+60>);
    Position ALIFu1 DAMMA (BEi9 <xAdvance=+40>) sda;
    Position ALIFu1 DAMMA (SINi9 <xAdvance=+40>);
    Position ALIFu1 FATHA (LAMi93 <xAdvance=+10>);
    Position ALIFu1 MADDA (space.urdu <xAdvance=+20>) SINi3;
    Position ALIFu1 MADDA (space.urdu <xAdvance=+40>) TEi6 tdb DAMMA;
    Position ALIFu1 MADDA (BEi6 <xAdvance=+20>) sda;
    Position ALIFu1 MADDA (TEi3 <xAdvance=+20>) HAMZA_ABOVE;
    Position ALIFu1 MADDA (TEi3 <xAdvance=+20>) HAMZA_ABOVE KASRA;
    Position ALIFu1 (space.urdu <xAdvance=+40>) BEi13 sda;
    Position ALIFu1 (space.urdu <xAdvance=+20>) DALu1 FATHA;
    Position ALIFu1 (space.urdu <xAdvance=+10>) SINi3 tda;
    Position ALIFu1 (BEisd1 <xAdvance=+10>) sdb KASRA;
    Position ALIFu1 (KAFi3 <xAdvance=+70>);
    Position ALIFu1 (LAMi1 <xAdvance=+20>);
    Position ALIFu1 (REu1 <xAdvance=+20>) toeda;
    Position ALIFu1 (TEi16 <xAdvance=+40>) tdb;
    Position BARI_YEf1 (JIMi24 <xAdvance=+50>) sdb KASRA;
    Position BARI_YEu1 (HAYCi13 <xAdvance=+40>) haydb;
    Position BEf1 sdb (space.urdu <xAdvance=+10>) TEi13 tdb.yb;
    Position BEf1 sdb (space.urdu <xAdvance=+10>) TEi6 ddb;
    Position BEf2 sdb (space.urdu <xAdvance=+20>) BEi8 sda KASRA;
    Position CH_YEf1 (space.urdu <xAdvance=+20>) ALIFu1 KASRA;
    Position CH_YEf1 (space.urdu <xAdvance=+40>) KAFisd15;
    Position CH_YEf1 (space.urdu <xAdvance=+10>) LAMi2 KASRA;
    Position CH_YEf1 (space.urdu <xAdvance=+20>) TEi13 tdb.yb;
    Position CH_YEu1 (space.urdu <xAdvance=+20>) ALIFu1 KASRA;
    Position CH_YEu1 (space.urdu <xAdvance=+180>) BEi13 sdb.yb;
    Position DALf1 KASRA.one (TEi3 <xAdvance=+40>) ddb.one;
    Position DALf1 (HAYAi13 <xAdvance=+40>);
    Position DALf1 (TEi3 <xAdvance=+40>) ddb;
    Position DALf1 (TEi3 <xAdvance=+60>) ddb.yb;
    Position DALu1 KASRA (KAFi5 <xAdvance=+20>);
    Position DALu1 KASRA (TEi3 <xAdvance=+40>) ddb.one;
    Position DALu1 KASRA (TEi6 <xAdvance=+30>) ddb;
    Position DALu1 KASRA (TEisd1 <xAdvance=+110>) ddb.one;
    Position DALu1 toeda (SINi18 <xAdvance=+20>);
    Position DALu1 toeda (TEi3 <xAdvance=+70>) ddb.one;
    Position DALu1 (BEisd1 <xAdvance=+10>) sda;
    Position DALu1 (KAFi5 <xAdvance=+20>);
    Position DALu1 (MIMi2 <xAdvance=+30>) KASRA;
    Position DALu1 (MIMi7 <xAdvance=+30>);
    Position DALu1 (TEi3 <xAdvance=+20>) ddb;
    Position DALu1 (TEi3 <xAdvance=+120>) ddb.one;
    Position DALu1 (TEi4 <xAdvance=+140>) ddb;
    Position DALu1 (TEisd1 <xAdvance=+170>) ddb;
    Position HAMZAu1 (MIMi3 <xAdvance=+50>);
    Position HAYCu1 (space.urdu <xAdvance=+20>) BEi8 sda KASRA;
    Position HAYCu1 (space.urdu <xAdvance=+10>) SINi7;
    Position JIMf1 sdi (space.urdu <xAdvance=+40>) KAFi16;
    Position JIMf1 (space.urdu <xAdvance=+10>) MIMi3 KASRA;
    Position JIMu1 sdi (space.urdu <xAdvance=+20>) REu1 FATHA;
    Position KAFf1 (space.urdu <xAdvance=+20>) TEi6 ddb KASRA;
    Position LAM_ALIFf1 (LAMi13 <xAdvance=+10>);
    Position LAM_ALIFu1 (TEi4 <xAdvance=+10>) HAMZA_ABOVE;
    Position LAMu1 (space.urdu <xAdvance=+20>) ALIFu1 KASRA;
    Position NUNf1 sdi (space.urdu <xAdvance=+20>) ALIFu1 KASRA;
    Position NUNf1 sdi (space.urdu <xAdvance=+10>) LAMi2 KASRA;
    Position NUNf1 (space.urdu <xAdvance=+20>) ALIFu1 KASRA;
    Position NUNf1 (space.urdu <xAdvance=+50>) JIMi3 tdb.yb;
    Position NUNf1 (space.urdu <xAdvance=+10>) MIMi3 KASRA;
    Position NUNu1 sdi (space.urdu <xAdvance=+10>) ALIFu1 KASRA;
    Position NUNu1 sdi (space.urdu <xAdvance=+20>) JIMi13 sdb.yb;
    Position NUNu1 sdi (space.urdu <xAdvance=+10>) LAMi2 KASRA;
    Position NUNu1 (space.urdu <xAdvance=+10>) ALIFu1 KASRA;
    Position QAFf1 dda (space.urdu <xAdvance=+20>) ALIFu1 KASRA;
    Position REf1 KASRA (TEi14 <xAdvance=+20>) tdb;
    Position REf1 sda (TEi14 <xAdvance=+50>) ddb;
    Position REf1 toeda (TEi14 <xAdvance=+50>) ddb;
    Position REf1 (space.urdu <xAdvance=+50>) LAMi13;
    Position REf1 (BEisd1 <xAdvance=+80>);
    Position REf1 (JIMi2 <xAdvance=+30>) sdb;
    Position REf1 (MIMi15 <xAdvance=+40>);
    Position REf1 (TEi14 <xAdvance=+50>) ddb;
    Position REf1 (TEisd1 <xAdvance=+80>) tdb.two;
    Position REf2 sda (TEi3 <xAdvance=+20>) ddb.one;
    Position REf2 sda (TEi8 <xAdvance=+70>) ddb;
    Position REf2 (space.urdu <xAdvance=+20>) DALu1 KASRA;
    Position REf2 (space.urdu <xAdvance=+40>) REu1 sda KASRA;
    Position REf2 (BEi3 <xAdvance=+50>) sdb.one;
    Position REf2 (BEisd1 <xAdvance=+50>) sdb;
    Position REf2 (TEi10 <xAdvance=+300>) ddb.two;
    Position REf2 (TEi3 <xAdvance=+40>) ddb.one;
    Position REf2 (TEi3 <xAdvance=+40>) tdb.one;
    Position REf3 sda KASRA (BEi3 <xAdvance=+70>) sda;
    Position REf3 sda KASRA (TEi3 <xAdvance=+70>) ddb.one;
    Position REf3 sda (GAFi13 <xAdvance=+20>);
    Position REf3 sda (GAFi3 <xAdvance=+230>);
    Position REf3 (GAFi2 <xAdvance=+20>);
    Position REf3 (JIMi18 <xAdvance=+10>) tdb.one;
    Position REf3 (SINi3 <xAdvance=+40>) tda;
    Position REf3 (TEi3 <xAdvance=+20>) ddb;
    Position REu1 DAMMA (JIMi10 <xAdvance=+10>) sda;
    Position REu1 DAMMA (SINi12 <xAdvance=+50>);
    Position REu1 sda FATHA (TEisd1 <xAdvance=+280>) ddb;
    Position REu1 sda KASRA (MIMu1 <xAdvance=+110>);
    Position REu1 sda KASRA (TEi3 <xAdvance=+110>) ddb.one;
    Position REu1 sda (LAMi4 <xAdvance=+30>);
    Position REu1 sda (MIMu1 <xAdvance=+110>);
    Position REu1 (space.urdu <xAdvance=+50>) BEi8 sda KASRA;
    Position REu1 (space.urdu <xAdvance=+10>) JIMi5 tdb.yb FATHA;
    Position REu1 (space.urdu <xAdvance=+90>) TEisd1 tdb;
    Position REu1 (ALIFu1 <xAdvance=+100>) KASRA;
    Position REu1 (BEi10 <xAdvance=+10>) sdb.one;
    Position REu1 (BEisd1 <xAdvance=+100>) sdb KASRA;
    Position REu1 (HAYCi10 <xAdvance=+110>) haydb.one;
    Position REu1 (JIMi18 <xAdvance=+60>) sdb.one;
    Position REu1 (JIMi5 <xAdvance=+290>) tdb.one;
    Position REu1 (JIMi6 <xAdvance=+100>) tdb.one;
    Position REu1 (MIMi2 <xAdvance=+50>);
    Position REu1 (TEi1 <xAdvance=+220>) ddb.one;
    Position REu1 (TEi6 <xAdvance=+130>) ddb.one;
    Position REu1 (TEi7 <xAdvance=+90>) ddb.one;
    Position REu1 (TEi8 <xAdvance=+190>) tdb;
    Position REu1 (TEisd1 <xAdvance=+300>) ddb;
    Position TEf1 dda (space.urdu <xAdvance=+10>) FEi13 sda;
    Position TEf1 dda (space.urdu <xAdvance=+20>) TEi6 ddb KASRA;
    Position TEf2 tdb (space.urdu <xAdvance=+10>) FEi13 sda;
    Position TEu1 toeda (space.urdu <xAdvance=+10>) LAMi13;
    Position VAOf1 HAMZA_ABOVE (SINisd24 <xAdvance=+90>);
    Position VAOf1 HAMZA_ABOVE (TOEi18 <xAdvance=+50>);
    Position VAOf1 HAMZA_ABOVE (TOEi4 <xAdvance=+80>) sda;
    Position VAOf1 (AINi13 <xAdvance=+30>);
    Position VAOf1 (BEi5 <xAdvance=+30>) sdb;
    Position VAOf1 (BEi7 <xAdvance=+240>) sda;
    Position VAOf1 (FEi2 <xAdvance=+40>) sda KASRA;
    Position VAOf1 (JIMi18 <xAdvance=+60>) sdb.one;
    Position VAOf1 (KAFisd15 <xAdvance=+60>);
    Position VAOf1 (LAMi3 <xAdvance=+40>) KASRA;
    Position VAOf1 (MIMi24 <xAdvance=+30>);
    Position VAOf1 (SINi10 <xAdvance=+50>);
    Position VAOf1 (SINi13 <xAdvance=+40>);
    Position VAOf1 (SINi3 <xAdvance=+20>) tda;
    Position VAOf1 (SINi6 <xAdvance=+80>) tda;
    Position VAOf1 (SINisd24 <xAdvance=+80>) tda;
    Position VAOf1 (SINisd24 <xAdvance=+300>) tda KASRA;
    Position VAOf1 (TEi3 <xAdvance=+20>) HAMZA_ABOVE KASRA;
    Position VAOf1 (TEi3 <xAdvance=+10>) dda;
    Position VAOf1 (TEi7 <xAdvance=+130>) dda DAMMA;
    Position VAOf1 (TOEi13 <xAdvance=+40>);
    Position VAOf1 (TOEi18 <xAdvance=+50>) sda;
    Position VAOf1 (TOEi4 <xAdvance=+40>) sda;
    Position VAOu1 DAMMA (HAYCi2 <xAdvance=+90>) haydb;
    Position VAOu1 FATHA (TEi24 <xAdvance=+20>) ddb.one;
    Position VAOu1 HAMZA_ABOVE (space.urdu <xAdvance=+10>) TEi3 dda;
    Position VAOu1 (AINi13 <xAdvance=+30>);
    Position VAOu1 (BEi7 <xAdvance=+40>) sda;
    Position VAOu1 (HAYCi3 <xAdvance=+80>) haydb KASRA;
    Position VAOu1 (JIMi18 <xAdvance=+60>) sdb.one;
    Position VAOu1 (SINi13 <xAdvance=+40>);
    Position VAOu1 (TEi24 <xAdvance=+60>) ddb;
    Position bullet (TEi24 <xAdvance=+60>) tdb;
    Position sallallahuAlayhiWasallam (space.urdu <xAdvance=+80>) KAFi13;
  } UseMarkFilteringSet [DAMMA FATHA HAMZA_ABOVE KASRA KASRA.one MADDA dda ddb ddb.one ddb.two ddb.yb haydb haydb.one sda sdb sdb.one sdb.yb sdi tda tdb tdb.one tdb.two tdb.yb toeda];


  # A few pairs whose dots or zer already came close before and now touch.
  Routine RoomAfterLowerPartsByHand {
    Position VAOf1 (TEisd1 <xAdvance=+60>) tda; # توثیق
    Position ALIFu1 (TEi16 <xAdvance=+60>) ddb; # ایران
    Position ALIFu1 (/^JIMi\d+$/ <xAdvance=+40>) tdb; # اچم
    Position DALu1 KASRA (TEisd1 <xAdvance=+60>) ddb.one; # دِینا
    Position DALu1 toeda (TEi3 <xAdvance=+50>) ddb.one; # ڈیٹیکٹر
    Position [REu1 REf2] KASRA (TEi15 <xAdvance=+60>) ddb.one; # رِیو
    Position [REu1 REf2] KASRA (TEi3 <xAdvance=+60>) ddb.yb; # تارِیکی
  } UseMarkFilteringSet [KASRA toeda tda ddb ddb.one ddb.yb tdb];

};
