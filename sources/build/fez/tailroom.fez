Include "shared.fez";

# Room after the tails of re, vao, dal, bari ye and the other letters whose
# final form reaches back under the next part of the word or the next word.
# For each pair of letters the next part may come at most a little way under
# the tail (0.05 alif height within a word, 0.23 between words), and no pair
# gets more than 70 units, so words keep their shape. The amounts were
# measured by setting a dictionary word list and word pairs; the word space is
# also 15 units narrower so the gaps between words stay even.
Feature kern {
  Routine SpaceWidth {
    Position (space.urdu <xAdvance=-15>);
  };
  Routine TailRoom {
    Position AINf1 (space.urdu <xAdvance=+70>) GAFi4;
    Position AINf1 (space.urdu <xAdvance=+70>) GAFi5;
    Position AINf1 (space.urdu <xAdvance=+70>) GAFi6;
    Position AINf1 (space.urdu <xAdvance=+70>) GAFi7;
    Position AINf1 (space.urdu <xAdvance=+70>) KAFi17;
    Position AINf1 (space.urdu <xAdvance=+70>) KAFi2;
    Position AINf1 (space.urdu <xAdvance=+70>) KAFi5;
    Position AINf1 (space.urdu <xAdvance=+70>) KAFi6;
    Position AINf1 (space.urdu <xAdvance=+70>) KAFi9;
    Position AINf1 (space.urdu <xAdvance=+70>) KAFisd15;
    Position AINf1 (space.urdu <xAdvance=+20>) LAMi93;
    Position AINf1 (space.urdu <xAdvance=+70>) TEi3;
